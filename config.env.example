# shellcheck shell=bash
# ============================================================================
# isucon-harness 設定
#   cp config.env.example config.env して埋める。config.env は .gitignore 済み。
#   当日埋める値は「すべて」このファイルに集約する。スクリプトに直書きしない。
# ============================================================================

# ---------------------------------------------------------------------------
# 競技サーバ
#   値は ~/.ssh/config 上のホスト別名。bin/setup が生成する。
# ---------------------------------------------------------------------------
ISU_HOSTS="isu1 isu2 isu3"      # 全ホスト（スペース区切り、再起動試験の対象）
ISU_APP_HOSTS="isu1"            # アプリを動かすホスト（deploy の配布先）
ISU_NGINX_HOSTS="isu1"          # nginx が動くホスト（access log の収集元）
ISU_DB_HOST="isu2"              # DB が動くホスト（slow query log の収集元）
ISU_PRIMARY="isu1"              # ベンチマーカーのリクエスト先 / ロックの保持先
ISU_USER="isucon"               # サーバ上の作業ユーザ

# ---------------------------------------------------------------------------
# アプリケーション
# ---------------------------------------------------------------------------
APP_REPO_LOCAL="${HOME}/projects/isucon2026-app"   # 手元のアプリリポジトリ。git ref はここで解決する
APP_DIR="/home/isucon/webapp"           # サーバ上のアプリ配置先
APP_LANG_DIR="go"                       # APP_DIR 配下の言語ディレクトリ
APP_BINARY="isuports"                   # ビルド成果物のファイル名
APP_SERVICE="isuports.go.service"       # systemctl のサービス名
APP_BUILD_CMD="GOOS=linux GOARCH=amd64 go build -o %BINARY% ./cmd/%BINARY%"
APP_BASE_URL="http://isu1"              # bin/check がリクエストを投げる先
APP_INITIALIZE_PATH="/initialize"

# ---------------------------------------------------------------------------
# ミドルウェア
# ---------------------------------------------------------------------------
NGINX_SERVICE="nginx.service"
DB_SERVICE="mysql.service"
NGINX_ACCESS_LOG="/var/log/nginx/access.log"
DB_SLOW_LOG="/var/log/mysql/mysql-slow.log"

# 追加で管理するサービス（finalize / verify-restart の enable 確認対象）
EXTRA_SERVICES=""               # 例: "redis-server.service"

# ---------------------------------------------------------------------------
# 計測
# ---------------------------------------------------------------------------
# alp の -m に渡す URI 正規化パターン（カンマ区切り）。当日のエンドポイントに合わせる。
ALP_MATCHES=""
# 例: ALP_MATCHES='/api/player/competition/[^/]+/ranking,/api/player/player/[^/]+'

ALP_SORT="sum"                  # alp の並び順（sum / avg / max / count）
ALP_LIMIT=30
PTQUERY_LIMIT=15

PPROF_ENABLED="false"           # アプリに pprof を仕込んだら true
PPROF_URL="http://isu1:6060/debug/pprof/profile?seconds=30"

RESOURCE_INTERVAL=1             # dstat のサンプリング間隔（秒）

# ---------------------------------------------------------------------------
# ポータル（ベンチマーカーの起動）
#   公開 API は無くブラウザ操作が前提。GitHub 認証の Django セッション Cookie を
#   手元に持ち出して curl から叩く。詳細は #3 と docs/DESIGN.md。
#   エンドポイントは当日判明するので、判明したらここを埋める。
# ---------------------------------------------------------------------------
PORTAL_BASE="https://portal.isucon.net"
PORTAL_COOKIE_FILE="${HOME}/.isucon/portal-cookie"
PORTAL_TEAM_ID=""
PORTAL_ENQUEUE_PATH=""          # 当日埋める（ベンチ登録）
PORTAL_JOB_PATH=""              # 当日埋める（ジョブ状態の取得）

# ---------------------------------------------------------------------------
# ベンチ実行
# ---------------------------------------------------------------------------
BENCH_LOCK_PATH="/tmp/isucon-bench.lock"   # ISU_PRIMARY 上のロックファイル
BENCH_LOCK_TIMEOUT=1800                    # ロック取得待ちの上限（秒）
BENCH_TIMEOUT=600                          # ベンチ 1 回の上限（秒）

# ベストスコアに対してこの割合を下回ったら「スコア低下」と判定する
SCORE_REGRESSION_RATIO=0.9
# スコア低下時に自動でロールバックするか（序盤は false、終盤は true を推奨）
AUTO_ROLLBACK="false"
