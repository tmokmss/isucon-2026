#!/usr/bin/env bash
# bin/portal — ポータルを Cookie 付き curl で操作する
# 契約: docs/DESIGN.md §3   実装: #3
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/portal <subcommand> [args]

  whoami            Cookie が有効か確認する（認証必須ページを引けるか）
  enqueue           ベンチを登録し、ジョブ ID を stdout に出す
  status <job-id>   ジョブ状態を出す（pending / running / done / failed）
  wait <job-id>     完了まで待ち、結果 JSON を stdout に出す
  score             最新の確定スコアを stdout に出す

ポータル (https://portal.isucon.net/) に公開 API は無く、ブラウザ操作が前提。
認証は /auth/login/ からの GitHub 認証で、Django のセッション Cookie 方式
（レスポンスに vary: Cookie）。ブラウザでログインした後の sessionid と
csrftoken を PORTAL_COOKIE_FILE に置いて使う。
POST には CSRF トークンが必要な想定（X-CSRFToken ヘッダ、または
csrfmiddlewaretoken フォーム値）。

ベンチ用のエンドポイントは当日にならないと分からない。判明したら
config.env の PORTAL_ENQUEUE_PATH / PORTAL_JOB_PATH を埋めるだけで済むようにする。
事前に検証できるのは whoami まで。
USAGE
}

main() {
    usage_guard "$@"
    local sub="${1:-}"
    [[ -z "$sub" ]] && { usage; exit "$EX_USAGE"; }
    shift
    load_config
    require_config PORTAL_BASE PORTAL_COOKIE_FILE
    case "$sub" in
        whoami|enqueue|score) log_info "portal $sub base=$PORTAL_BASE" ;;
        status|wait)
            [[ -z "${1:-}" ]] && die "$EX_USAGE" "$sub には job-id が必要です"
            log_info "portal $sub job=$1"
            ;;
        *) die "$EX_USAGE" "不明なサブコマンド: $sub" ;;
    esac
    not_implemented 3
}
main "$@"
