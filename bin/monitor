#!/usr/bin/env bash
# bin/monitor — 全ホストのリソースを 1 画面で見る
# 契約: docs/DESIGN.md §3   実装: #17
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/monitor

ISU_HOSTS 全台の dstat / htop を tmux で 1 画面に並べる。
ベンチ実行中にどのホストが飽和しているかを見るのが目的。
凝ったダッシュボードは当日使わない可能性が高いので、まず tmux + dstat で十分。
USAGE
}

main() {
    usage_guard "$@"
    (( $# > 0 )) && die "$EX_USAGE" "引数は取らない: $*"
    load_config
    log_info "monitor hosts=[$ISU_HOSTS] interval=${RESOURCE_INTERVAL}s"
    not_implemented 17
}
main "$@"
