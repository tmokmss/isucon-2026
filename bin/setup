#!/usr/bin/env bash
# bin/setup — インスタンス起動後のセットアップ
# 契約: docs/DESIGN.md §3   実装: #9 #11
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/setup [--only <step>]

インスタンス起動後のセットアップを 1 コマンドで行う。
IaC は運営から渡されるものを使うため触れない。自動化できるのは「起動した後」だけで、
ここを詰めると当日の最初の 30〜60 分が浮く。

  --only <step>   指定したステップだけ実行する

steps:
  ssh        SSH 鍵の生成と全台への配布、~/.ssh/config（isu1/isu2/isu3）生成
  hosts      /etc/hosts の整備
  dotfiles   .bashrc / .tmux.conf / .vimrc / .inputrc の配置
  tools      alp / percona-toolkit / dstat / htop の導入（オフライン同梱分を優先）
  apprepo    ~/webapp を git 化して自分のリポジトリへ push（元は webapp_bak へ退避）

終了コード: 0 成功 / 64 引数不正 / 65 設定不備
USAGE
}

main() {
    usage_guard "$@"
    local only=""
    while (( $# > 0 )); do
        case "$1" in
            --only) shift; only="${1:-}"; [[ -z "$only" ]] && die "$EX_USAGE" "--only に値がありません" ;;
            -*) die "$EX_USAGE" "不明なオプション: $1" ;;
            *)  die "$EX_USAGE" "不明な引数: $1" ;;
        esac
        shift
    done
    load_config
    log_info "setup hosts=[$ISU_HOSTS] only=${only:-<all>}"
    not_implemented 9
}
main "$@"
