#!/usr/bin/env bash
# bin/bench — ロック取得からレポート生成までの通し実行
# 契約: docs/DESIGN.md §1 §7   実装: #2 #4
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/bench [<git-ref>] [--skip-check] [--note <text>]

デプロイからレポート生成までを 1 つのクリティカルセクションで実行する。
並列に走る他の作業が計測を汚染しないよう、全体をロックで保護する。

  <git-ref>       デプロイする ref（既定: HEAD、APP_REPO_LOCAL で解決）
  --skip-check    bin/check を省略する（非推奨）
  --note <text>   history.tsv に残すメモ

流れ:
   1. ロック取得（ISU_PRIMARY 上の flock を ssh セッションで保持）
   2. git ref を sha に解決
   3. bin/deploy <sha>
   4. bin/check                     ← deploy の後。落ちたらベンチを起動しない
   5. ログのリセット + リソース計測開始
   6. bin/portal enqueue → 完了待ち
   7. 計測停止・ログ収集（alp / pt-query-digest / pprof / リソース）
   8. runs/<run-id>/ に report.md と meta.json を生成、history.tsv に追記
   9. スコア判定（AUTO_ROLLBACK なら低下時に戻す）
  10. ロック解放（trap で異常終了時も必ず実行）

終了コード: 0 / 10 ロック / 20 デプロイ / 30 check / 40 ベンチ / 50 スコア低下
USAGE
}

main() {
    usage_guard "$@"
    local ref="HEAD" skip_check=0 note=""
    while (( $# > 0 )); do
        case "$1" in
            --skip-check) skip_check=1 ;;
            --note) shift; note="${1:-}"; [[ -z "$note" ]] && die "$EX_USAGE" "--note に値がありません" ;;
            -*) die "$EX_USAGE" "不明なオプション: $1" ;;
            *)  ref="$1" ;;
        esac
        shift
    done

    load_config
    local sha run_id
    sha="$(resolve_sha "$ref")"
    run_id="$(new_run_id "$sha")"
    log_info "bench run_id=$run_id ref=$ref sha=${sha:0:7} skip_check=$skip_check note='${note}'"

    # 実装時は trap 'lock_release' EXIT を必ず張ること（docs/DESIGN.md §7）
    not_implemented 2
}
main "$@"
