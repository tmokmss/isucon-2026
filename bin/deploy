#!/usr/bin/env bash
# bin/deploy — 指定した git ref をビルドして全台へ配布・再起動する
# 契約: docs/DESIGN.md §3   実装: #1
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/deploy [<git-ref>] [--dry-run]

指定した git ref のアプリをビルドし、ISU_APP_HOSTS へ配布して再起動する。
ref は APP_REPO_LOCAL（手元のアプリリポジトリ）で解決する。既定は HEAD。

  <git-ref>   デプロイする ref
  --dry-run   何をするかを表示して実行しない

デプロイ後、各ホストに現在の sha を記録すること。
nginx.conf や my.cnf などアプリ以外の配布もこのコマンドで行う。

終了コード: 0 成功 / 20 デプロイ失敗 / 64 引数不正 / 65 設定不備
USAGE
}

main() {
    usage_guard "$@"
    local ref="HEAD" dry_run=0
    while (( $# > 0 )); do
        case "$1" in
            --dry-run) dry_run=1 ;;
            -*) die "$EX_USAGE" "不明なオプション: $1" ;;
            *)  ref="$1" ;;
        esac
        shift
    done

    load_config
    local sha; sha="$(resolve_sha "$ref")"
    log_info "deploy ref=$ref sha=${sha:0:7} hosts=[$ISU_APP_HOSTS] dry_run=$dry_run"

    not_implemented 1
}
main "$@"
