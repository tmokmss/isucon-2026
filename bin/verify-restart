#!/usr/bin/env bash
# bin/verify-restart — 再起動試験（失格回避）
# 契約: docs/DESIGN.md §3   実装: #7
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() {
    cat <<'USAGE'
usage: bin/verify-restart [--times <n>]

ISU_HOSTS を「ランダム順」で再起動し、全台の起動を待ってから
initialize を叩かずにベンチを実行して、直前スコアと比較する。

  --times <n>   繰り返し回数（既定: 1）。順序依存の事故を炙り出すため複数回まわす

レギュレーションより:
  - 主催者がインスタンスを再起動する順序は保証しない
  - 正常にベンチが完了しない、または競技中のスコアに近い結果が再現されない場合は失格
  - ベンチで書き込まれたデータは再起動後にも取得できること

あわせて確認すること:
  - systemd の enable 漏れ（systemctl is-enabled）
  - 再起動後にデータが残っていること

オンメモリ化・キャッシュ戦略はここで死ぬ。マージ前に必ず通す。

終了コード: 0 成功 / 40 ベンチ失敗 / 50 スコア低下
USAGE
}

main() {
    usage_guard "$@"
    local times=1
    while (( $# > 0 )); do
        case "$1" in
            --times) shift; times="${1:-1}" ;;
            -*) die "$EX_USAGE" "不明なオプション: $1" ;;
            *)  die "$EX_USAGE" "不明な引数: $1" ;;
        esac
        shift
    done
    load_config
    log_info "verify-restart hosts=[$ISU_HOSTS] times=$times"
    not_implemented 7
}
main "$@"
